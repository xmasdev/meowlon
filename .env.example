# Hall of Explorers database (Upstash Redis — free tier).
# Create a Redis database at https://console.upstash.com, open the REST API
# section, and copy the URL and token here. Restart `next dev` afterwards.

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# If you deploy via the Vercel + Upstash integration, it injects these instead:
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
